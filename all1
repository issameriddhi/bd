#Bloom Filter
from bitarray import bitarray
import random

size = 512

bloom = bitarray(size)
bloom.setall(0)

def hashf(num):
    h1 = num % size
    h2 = (3*num + 7) % size
    h3 = (5*num + 11) % size
    h4 = (7*num + 13) % size

    return [h1, h2, h3, h4]

for i in range(500):
    num = random.randint(1, 2000)
    for h in hashf(num):
        bloom[h] = 1

print("Bloom Filter:", bloom.to01())
checknum = int(input("Enter number to check: "))
present = True

for h in hashf(checknum):
    if bloom[h] == 0:
        present = False
        break
if present:
    print("Possibly Present")
else:
    print("Definitely Not Present")



#AMS 
import random
n = 600
pos = sorted(random.sample(range(1, n+1), 4))

elem = [None] * 4
count = [0] * 4

print("Selected Positions:", pos)

for t in range(1, n+1):
    x = random.randint(1, 100)

    for i in range(4):
        if t == pos[i]:
            elem[i] = x
            count[i] = 1

        elif t > pos[i] and x == elem[i]:
            count[i] += 1

total = 0

for i in range(4):
    estimate = n * (2 * count[i] - 1)
    total += estimate

    print("Position:", pos[i],
          "| Element:", elem[i],
          "| Count:", count[i],
          "| Estimate:", estimate)

print("Final AMS Estimate:", total / 4)

